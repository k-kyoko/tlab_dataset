# ===== Python / uv =====
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.virtual_documents/
# uv.lock is intentionally tracked: it is what makes the environment reproducible.

# ===== Data (kept out of Git; source of truth is ~/ResearchData_keep) =====
# Ignore the contents, not the directory itself, so .gitkeep can be an exception.
# This covers both the data/source symlink and data/interim.
data/*
!data/.gitkeep

# ===== Results =====
# Figures are regenerable, so they stay local. CSV tables under results/tables/ are tracked.
results/figures/*
!results/figures/.gitkeep

# ===== Other generated artifacts =====
*.h5

# ===== Environment / secrets =====
.env

# ===== OS / editors =====
.DS_Store
.vscode/
.idea/
